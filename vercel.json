{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "meeting-cleanerv1.vercel.app"
        }
      ],
      "destination": "https://meetclean.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt|ads\\.txt|favicon\\.svg|apple-touch-icon\\.png|og-image\\.png|guide-compte-rendu-reunion|modele-compte-rendu-reunion|exemple-compte-rendu-reunion|plan-d-action-reunion).*)",
      "destination": "/index.html"
    }
  ]
}
